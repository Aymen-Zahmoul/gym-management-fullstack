{
  "info": {
    "name": "HADID - Gym Management API (Java Pur Native)",
    "_postman_id": "hadid-gym-api-v2",
    "description": "Collection de tests Postman officielle et exhaustive pour le projet fédérateur Java Web (ENICarthage).\nArchitecture N-Tiers sans Spring Boot : HttpServer natif Java 21 + JDBC + MySQL.\nBinôme : Aymen Zahmoul (Lead Architect ~65%) & Aziz (Domain Developer ~35%).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081/api",
      "type": "string",
      "description": "URL de base de l'API REST (bascule sur 8081 si le port 8080 est occupé)"
    }
  ],
  "item": [
    {
      "name": "0. Authentification (Auth)",
      "item": [
        {
          "name": "Connexion Administrateur (Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@carthagefitness.tn\",\n  \"motDePasse\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Authentifie le directeur du club et renvoie le profil complet avec le rôle ADMIN."
          }
        },
        {
          "name": "Connexion Coach Actif",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"karim.coach@carthagefitness.tn\",\n  \"motDePasse\": \"coach123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Authentifie un coach officiel actif avec le rôle COACH."
          }
        },
        {
          "name": "Connexion Adhérent (Member)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"yassine.khemir@gmail.com\",\n  \"motDePasse\": \"pass123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Authentifie un membre actif avec le rôle MEMBER."
          }
        }
      ]
    },
    {
      "name": "1. Dashboard & KPIs",
      "item": [
        {
          "name": "Obtenir les statistiques globales (Admin)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/dashboard",
              "host": ["{{baseUrl}}"],
              "path": ["dashboard"]
            },
            "description": "Calcule et agrège en temps réel : total membres actifs, séances du jour, taux d'occupation, CA mensuel et alertes impayés."
          }
        },
        {
          "name": "Obtenir les informations du Club (Gym)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/gym",
              "host": ["{{baseUrl}}"],
              "path": ["gym"]
            },
            "description": "Retourne les coordonnées officielles de la salle de sport (Carthage Fitness Club )."
          }
        }
      ]
    },
    {
      "name": "2. Adhérents (Members CRUD)",
      "item": [
        {
          "name": "C - Inscrire un nouvel adhérent (POST)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nomComplet\": \"Tarek Dridi\",\n  \"email\": \"tarek.dridi@gmail.com\",\n  \"telephone\": \"+216 55 123 789\",\n  \"initialPlanId\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/members",
              "host": ["{{baseUrl}}"],
              "path": ["members"]
            },
            "description": "Crée un nouvel utilisateur avec le rôle MEMBER, statut ACTIF, et génère son adhésion initiale."
          }
        },
        {
          "name": "R - Lister tous les adhérents (GET)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/members",
              "host": ["{{baseUrl}}"],
              "path": ["members"]
            },
            "description": "Récupère le fichier complet des adhérents avec leurs statuts d'adhésion."
          }
        },
        {
          "name": "R - Obtenir un adhérent par son ID (GET)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/members/5",
              "host": ["{{baseUrl}}"],
              "path": ["members", "5"]
            },
            "description": "Consulte la fiche détaillée de l'adhérent ID 5."
          }
        },
        {
          "name": "U - Mettre à jour un adhérent (PUT)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nomComplet\": \"Tarek Dridi Modifié\",\n  \"telephone\": \"+216 55 999 888\",\n  \"statut\": \"ACTIF\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/members/5",
              "host": ["{{baseUrl}}"],
              "path": ["members", "5"]
            },
            "description": "Met à jour les coordonnées ou le statut de l'adhérent."
          }
        },
        {
          "name": "D - Supprimer / Radier un adhérent (DELETE)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/members/10",
              "host": ["{{baseUrl}}"],
              "path": ["members", "10"]
            },
            "description": "Supprime définitivement un adhérent avec suppression en cascade de ses réservations."
          }
        }
      ]
    },
    {
      "name": "3. Demandes de Créneaux Coach (Scheduling Requests)",
      "item": [
        {
          "name": "C - Soumettre une demande récurrente (POST Coach)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"coachId\": 2,\n  \"gymId\": 1,\n  \"activite\": \"Boxe Sparring Pro\",\n  \"classId\": 1,\n  \"joursSemaine\": \"LUNDI,VENDREDI\",\n  \"heureDebut\": \"17:00:00\",\n  \"heureFin\": \"19:00:00\",\n  \"dateDebut\": \"2026-11-09\",\n  \"dateFin\": \"2026-11-30\",\n  \"salle\": \"Dojo & Ring 1\",\n  \"remarques\": \"Préparation tournoi national\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/scheduling-requests",
              "host": ["{{baseUrl}}"],
              "path": ["scheduling-requests"]
            },
            "description": "Le coach soumet une demande de cours récurrent. Statut initial : PENDING (n'apparaît pas au calendrier des membres)."
          }
        },
        {
          "name": "R - Lister toutes les demandes (GET Admin)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/scheduling-requests",
              "host": ["{{baseUrl}}"],
              "path": ["scheduling-requests"]
            },
            "description": "L'administrateur consulte l'ensemble des demandes de créneaux en attente ou traitées."
          }
        },
        {
          "name": "R - Lister les demandes d'un Coach spécifique (GET Coach)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/scheduling-requests/coach/2",
              "host": ["{{baseUrl}}"],
              "path": ["scheduling-requests", "coach", "2"]
            },
            "description": "Filtre les demandes appartenant au coach ID 2 (Karim Ben Ali)."
          }
        },
        {
          "name": "R - Vérifier les conflits de salle (GET Admin)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/scheduling-requests/3/conflicts",
              "host": ["{{baseUrl}}"],
              "path": ["scheduling-requests", "3", "conflicts"]
            },
            "description": "Vérifie si les créneaux demandés chevauchent des cours déjà programmés dans la même salle."
          }
        },
        {
          "name": "U - Approuver une demande de créneaux (POST Admin)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/scheduling-requests/3/approve",
              "host": ["{{baseUrl}}"],
              "path": ["scheduling-requests", "3", "approve"]
            },
            "description": "Valide la demande (statut APPROVED) et GÉNÈRE AUTOMATIQUEMENT toutes les séances associées dans la table class_session."
          }
        },
        {
          "name": "U - Rejeter une demande avec motif (POST Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"motif\": \"Salle réservée pour un stage ce créneau-là\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/scheduling-requests/3/reject",
              "host": ["{{baseUrl}}"],
              "path": ["scheduling-requests", "3", "reject"]
            },
            "description": "Décline la demande (statut REJECTED) et enregistre le motif du refus pour le coach."
          }
        }
      ]
    },
